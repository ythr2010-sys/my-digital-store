{
  "corsRuleName": "digivault-web",
  "allowedOrigins": [
    "https://ythr2010-sys.github.io"
  ],
  "allowedMethods": [
    "GET",
    "PUT",
    "HEAD"
  ],
  "allowedHeaders": [
    "*"
  ],
  "exposeHeaders": [
    "ETag",
    "Content-Length",
    "Content-Type"
  ],
  "maxAgeSeconds": 3600
}
