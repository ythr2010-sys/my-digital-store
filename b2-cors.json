{
  "corsRuleName": "digivault-web",
  "allowedOrigins": [
    "https://ythr2010-sys.github.io"
  ],
  "allowedOperations": [
    "s3_get",
    "s3_put",
    "s3_head"
  ],
  "allowedHeaders": [
    "*"
  ],
  "exposeHeaders": [
    "ETag",
    "Content-Length",
    "Content-Type"
  ],
  "maxAgeSeconds": 3600
}
