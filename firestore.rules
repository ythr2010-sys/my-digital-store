rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          userEmail() == 'ythr2010@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(userEmail()))
        );
    }

    function isFreePrice(value) {
      return value == 'مجاني' || value == 'مجانية' || value == '0' || value == '0.0' || value == '0.00' || value == '0.000' || value == '$0' || value == '$0.0' || value == '$0.00' || value == '0$' || value == '0.0$' || value == '0.00$' || value == 0 || value == 0.0;
    }

    function isApprovedFreeProduct(productId) {
      return exists(/databases/$(database)/documents/products/$(productId))
        && get(/databases/$(database)/documents/products/$(productId)).data.status == 'approved'
        && isFreePrice(get(/databases/$(database)/documents/products/$(productId)).data.price);
    }

    match /products/{productId} {
      allow read: if isAdmin()
        || resource.data.status == 'approved'
        || (isSignedIn() && resource.data.sellerEmail == userEmail());

      allow create: if isSignedIn()
        && request.resource.data.sellerEmail == userEmail()
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.sellerEmail == userEmail()
          && request.resource.data.sellerEmail == resource.data.sellerEmail
          && (resource.data.status == 'pending' || resource.data.status == 'rejected' || resource.data.status == 'approved')
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'title','description','price','category','imageUrl','imageUrls',
                'promoImages','updatedAt','status','rejectionReason'
              ])
        );

      allow delete: if isAdmin();
    }

    match /product_files/{productId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.sellerEmail == userEmail())
        || (isSignedIn() && isApprovedFreeProduct(productId));

      allow create: if isSignedIn()
        && request.resource.data.sellerEmail == userEmail()
        && exists(/databases/$(database)/documents/products/$(productId))
        && get(/databases/$(database)/documents/products/$(productId))
             .data.sellerEmail == userEmail();

      allow update: if isSignedIn()
        && resource.data.sellerEmail == userEmail()
        && request.resource.data.sellerEmail == resource.data.sellerEmail;

      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.buyerUid == request.auth.uid || resource.data.buyerEmail == userEmail()));

      allow create: if isSignedIn()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.buyerEmail == userEmail()
        && request.resource.data.status == 'pending';

      allow update, delete: if isAdmin();
    }

    match /free_purchases/{purchaseId} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.buyerUid == request.auth.uid || resource.data.buyerEmail == userEmail()));

      allow create: if isSignedIn()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.buyerEmail == userEmail()
        && request.resource.data.productId is string
        && isApprovedFreeProduct(request.resource.data.productId)
        && purchaseId == request.auth.uid + '_' + request.resource.data.productId;

      allow update, delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if isAdmin()
        && request.resource.data.userEmail is string
        || (isSignedIn()
          && request.resource.data.userEmail == userEmail()
          && request.resource.data.type in ['product_submission', 'free_purchase']);

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userEmail == userEmail());

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userEmail == userEmail()
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['read'])
        );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userEmail == userEmail());
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userEmail == userEmail();
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userEmail == userEmail());
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userEmail == userEmail();

      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userEmail == userEmail())
        || (
          isSignedIn()
          && resource.data.productId is string
          && exists(/databases/$(database)/documents/products/$(resource.data.productId))
          && get(/databases/$(database)/documents/products/$(resource.data.productId))
               .data.sellerEmail == userEmail()
        );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userEmail == userEmail());
    }

    match /users/{uid} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid);

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (
          request.resource.data.role == 'user'
          || (isAdmin() && request.resource.data.role == 'admin')
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['role', 'email', 'uid'])
        );

      allow delete: if isAdmin();
    }

    match /admins/{adminEmail} {
      allow read: if isAdmin() && adminEmail == userEmail();
      allow create, update, delete: if false;
    }

    match /visits/{visitId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
